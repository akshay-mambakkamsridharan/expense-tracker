# Copy to .env.local and fill in. .env.local is git-ignored.
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB=expense_tracker

# AI provider for savings ideas: "ollama" (free, runs locally) or "openai".
# Defaults to openai when OPENAI_API_KEY is set, otherwise ollama.
AI_PROVIDER=ollama
# OLLAMA_MODEL=llama3.2:3b
# OLLAMA_BASE_URL=http://localhost:11434/v1

# Only needed for AI_PROVIDER=openai. Get a key at https://platform.openai.com/api-keys
OPENAI_API_KEY=
# OPENAI_MODEL=gpt-5-mini
